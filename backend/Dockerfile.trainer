# ──────────────────────────────────────────────────────────────
# backend/Dockerfile.trainer — ARQ Trainer Worker
#
# หมายเหตุ GPU: ไม่ต้องใช้ nvidia/cuda base image — pip/uv จะติดตั้ง
# torch wheel ที่แปะ CUDA runtime (nvidia-cudnn-cu13, nvidia-cublas ฯลฯ)
# มาให้เองอยู่แล้ว สิ่งที่ทำให้ container มองเห็น GPU จริงคือ host มี
# NVIDIA driver + nvidia-container-toolkit (ยืนยันแล้วจาก `docker info`
# ที่โชว์ Runtime: nvidia) ร่วมกับ deploy.resources.reservations.devices
# ใน compose.yml — แค่นั้นพอ
#
# Build:  docker compose build trainer-worker
# ──────────────────────────────────────────────────────────────

FROM python:3.12-slim

# ── System deps (build-essential จำเป็นสำหรับ compile sdist เช่น numpy/seqeval) ──
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl git libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Install uv ──
RUN pip install --no-cache-dir uv

WORKDIR /app

# ── Install Python deps (cache layer) ──
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# ── Copy source ──
COPY . .

# ── Log directory ──
RUN mkdir -p /logs
ENV LOG_DIR=/logs

CMD ["uv", "run", "arq", "app.features.workers.tasks.WorkerSettings"]